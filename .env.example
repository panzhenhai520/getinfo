# Web
FLASK_HOST=0.0.0.0
FLASK_PORT=8003
FLASK_DEBUG=false
SECRET_KEY=change-me-before-production
SESSION_LIFETIME=86400
AUTH_CHECK_INTERVAL=3600
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=change-me-before-production
DEFAULT_ADMIN_EMAIL=admin@example.com
DEFAULT_ADMIN_FULL_NAME=System Admin

# Database
DATABASE_TYPE=postgres
# 回退开关：true 时 PG 连不上会静默改用 SQLite 文件库，方言差异（boolean/json/主键类型）
# 会在本机被掩盖、到生产才暴露。生产环境已设为 false；建议本机也保持 false。
DATABASE_FALLBACK_TO_SQLITE=false
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=collectinfo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
SQLITE_BACKUP_PATH=data/crawler_articles.db
DATABASE_PATH=data/crawler_articles.db

# Local storage
CRAWL_RESULTS_DIR=crawl_results
AUTH_STORAGE_DIR=auth_storage
FINANCIAL_RAGFLOW_KB_ID=

# Logs
LOG_LEVEL=INFO
LOG_FILE=app.log

# Scheduler
CRAWL_SCHEDULER_MAX_CONCURRENT=4
CRAWL_SCHEDULER_MAX_PER_DOMAIN=1
CRAWL_SCHEDULER_RETRIES=2
CRAWL_SCHEDULER_RETRY_BACKOFF=20
CRAWL_SCHEDULER_DOMAIN_COOLDOWN=5
CRAWL_SCHEDULER_TASK_TIMEOUT=7200
CRAWL_SCHEDULER_COMPLETED_RETENTION=3600

# Crawl behavior
CRAWL_TLS_VERIFY=true
CRAWL_ALLOW_PRIVATE_NETWORKS=false
# Comma-separated explicit exceptions for controlled intranet sources only.
CRAWL_ALLOWED_PRIVATE_HOSTS=
CRAWL_MAX_URLS_PER_REQUEST=20
CRAWL_MAX_RESPONSE_BYTES=8388608
MANUAL_CRAWL_MAX_WORKERS=1
MANUAL_CRAWL_MAX_QUEUED=10
CRAWL_TIMEOUT=30
CRAWL_WAIT_TIME=3
CRAWL_RENDER_WAIT_MS=8000
CRAWL_PLAYWRIGHT_CLICK_TIMEOUT_MS=1200
CRAWL_LINK_DISCOVERY_MAX_PAGES=30
CRAWL_LINK_DISCOVERY_MAX_PAGES_WITH_LIMIT=10
CRAWL_PLAYWRIGHT_MAX_EMPTY_PAGES=5
CRAWL_DETAIL_MAX_RETRIES=2
CRAWL_DATE_RANGE_PRIORITY=true
CRAWL_PREFILTER_CANDIDATE_DATES=true
CRAWL_NETWORK_JSON_ENABLED=true
CRAWL_SUPPLEMENTAL_ENABLED=true
CRAWL_SUPPLEMENTAL_HTML_ENABLED=true
CRAWL_SUPPLEMENTAL_ATTRIBUTES_ENABLED=true
CRAWL_SUPPLEMENTAL_STRUCTURED_ENABLED=true
CRAWL_SUPPLEMENTAL_SCRIPTS_ENABLED=true
CRAWL_SUPPLEMENTAL_STATIC_PAGINATION_ENABLED=true
CRAWL_SUPPLEMENTAL_FEEDS_ENABLED=true
CRAWL_SUPPLEMENTAL_SITEMAPS_ENABLED=true
CRAWL_SUPPLEMENTAL_MAX_PER_SOURCE=500
CRAWL_SUPPLEMENTAL_MAX_SITEMAPS=25
CRAWL_SUPPLEMENTAL_MAX_STATIC_PAGES=8
CRAWL_USE_PROXY_DEFAULT=false
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36

# Proxy for public websites. Keep disabled unless the customer explicitly needs it.
PROXY_ENABLED=false
PROXY_HTTP=
PROXY_HTTPS=
PROXY_SOCKS5=
PLAYWRIGHT_PROXY=

# RAGFlow knowledge base upload.
# Set BASE_URL/API_KEY and change RAGFLOW_UPLOAD_ENABLED to true before delivery
# if scheduled crawls should upload articles into RAGFlow.
RAGFLOW_BASE_URL=
RAGFLOW_API_KEY=
RAGFLOW_UPLOAD_ENABLED=false
RAGFLOW_AUTO_PARSE=true
RAGFLOW_TIMEOUT=45
RAGFLOW_UPLOAD_RETRIES=1
RAGFLOW_TTS_ENABLED=true
RAGFLOW_TTS_TIMEOUT=60
RAGFLOW_TTS_MAX_CHARS=500
# Optional parameters passed to RAGFlow's TTS service. Voice values must be valid
# voice IDs exposed by the connected RAGFlow deployment.
RAGFLOW_TTS_MODEL=
RAGFLOW_TTS_VOICE_ZH=
RAGFLOW_TTS_VOICE_EN=
RAGFLOW_TTS_LANGUAGE_MODE=auto
RAGFLOW_TTS_PREBUFFER_SENTENCES=3
RAGFLOW_TTS_CACHE_DAYS=30
RAGFLOW_TTS_CACHE_MAX_MB=1024
# JSON voice catalog, e.g. [{"id":"provider-zh-female","label":"中文女声","language":"zh"}]
RAGFLOW_TTS_VOICE_CATALOG=[]
INTEL_TTS_ENGINE=CosyVoice3
INTEL_TTS_VOICE_PROFILE=male_mandarin_01
INTEL_TTS_DIALECT=mandarin
INTEL_TTS_GENDER=male
INTEL_TTS_EMOTION=lively
INTEL_TTS_SPEED=1.15
INTEL_TTS_BUFFER_MS=1400
INTEL_TTS_SEGMENT_MAX_CHARS_ZH=50
INTEL_TTS_SEGMENT_MAX_WORDS_EN=20
RAGFLOW_PROXY_ENABLED=false
RAGFLOW_PROXY_HTTP=
RAGFLOW_PROXY_HTTPS=
RAGFLOW_PROXY_SOCKS5=

# Market intelligence radar. External/automatic capabilities stay disabled
# until the corresponding stage gate has passed in the target environment.
CRAWL_REQUIRE_KEYWORD_MATCH=true
INTEL_DEFAULT_INDUSTRY_PACK=family_office
INTEL_CLASSIFICATION_ENABLED=true
INTEL_SOURCE_SYNC_ENABLED=true
INTEL_SOURCE_SYNC_INTERVAL_HOURS=24
INTEL_LIGHT_SCANNER_ENABLED=false
INTEL_LIGHT_SCAN_INTERVAL_MINUTES=15
INTEL_SCAN_MAX_SOURCES_PER_RUN=150
INTEL_SCAN_MAX_ITEMS_PER_SOURCE=100
INTEL_SCAN_CONNECT_TIMEOUT_SECONDS=5
INTEL_SCAN_READ_TIMEOUT_SECONDS=20
INTEL_SCAN_MAX_RESPONSE_BYTES=5000000
INTEL_SCAN_MAX_REDIRECTS=5
INTEL_PRIVATE_NETWORK_ALLOWLIST=
INTEL_CANDIDATE_DISPATCH_ENABLED=false
INTEL_CANDIDATE_BATCH_SIZE=10
INTEL_CANDIDATE_LEASE_SECONDS=600
INTEL_CANDIDATE_MAX_RETRIES=3
INTEL_TOPIC_CLUSTER_ENABLED=false
INTEL_TOPIC_CLUSTER_INTERVAL_MINUTES=60
INTEL_TOPIC_SUMMARY_MIN_ARTICLES=2
INTEL_WORKER_POLL_SECONDS=5
INTEL_WORKER_BATCH_SIZE=20
INTEL_JOB_LEASE_SECONDS=300
INTEL_JOB_MAX_RETRIES=3
INTEL_JOB_PRIORITY_AGING_SECONDS=30
# 行业演化趋势（第一阶段 baseline）+ 文章向量 Embedding（为第三阶段铺路）
INTEL_TREND_AGGREGATE_ENABLED=false
INTEL_TREND_AGGREGATE_INTERVAL_MINUTES=360
INTEL_TREND_WINDOW_DAYS=90
INTEL_TREND_BURST_WINDOW=7
INTEL_EMBEDDING_ENABLED=false
INTEL_EMBEDDING_BASE_URL=http://192.168.0.64:9997
INTEL_EMBEDDING_MODEL=bge-m3
INTEL_EMBEDDING_BATCH_SIZE=16
INTEL_EMBEDDING_INTERVAL_MINUTES=60
INTEL_EMBEDDING_MAX_ARTICLES_PER_RUN=200
INTEL_EMBEDDING_TIMEOUT_SECONDS=30
INTEL_EMBEDDING_MAX_INPUT_CHARS=4000
# 事件抽取（第二阶段：LLM 抽结构化事件 + event_hash 聚类）
INTEL_EVENT_EXTRACT_ENABLED=false
INTEL_EVENT_EXTRACT_INTERVAL_MINUTES=720
INTEL_EVENT_EXTRACT_MAX_ARTICLES_PER_RUN=20
INTEL_LLM_EVENT_TIMEOUT_SECONDS=60
INTEL_LLM_EVENT_MAX_INPUT_CHARS=8000
INTEL_EVENT_TREND_WINDOW_DAYS=90
INTEL_EVENT_TREND_BURST_WINDOW=7

SERPAPI_ENABLED=false
SERPAPI_API_KEY=
SERPAPI_ENGINE=google
SERPAPI_DEFAULT_REGION=hk
SERPAPI_DEFAULT_LANGUAGE=zh-cn
SERPAPI_TIMEOUT_SECONDS=20
SERPAPI_MAX_RETRIES=2
SERPAPI_MAX_QUERIES_PER_RUN=6
SERPAPI_DAILY_QUERY_BUDGET=100

# Reuse the homepage AI assistant model configuration from data/chat_config.json.
# The "local" entry supplies base_url, api_key, model_id and proxy behavior.
INTEL_LLM_ENABLED=false
INTEL_LLM_PROVIDER=local
INTEL_LLM_CHAT_MODEL_ID=local
INTEL_LLM_TIMEOUT_SECONDS=90
INTEL_LLM_MAX_RETRIES=1
INTEL_LLM_MAX_INPUT_CHARS=12000
INTEL_LLM_MAX_CONCURRENCY=2
INTEL_LLM_INTERACTIVE_RESERVED=1

# 双通道爬取：开发机永不启动浏览器；VPN 健康时调用 Ubuntu Pipeline。
PIPELINE_MODE=auto
REMOTE_PIPELINE_URL=http://10.88.0.1:11236
REMOTE_PIPELINE_TOKEN=
REMOTE_PIPELINE_HEALTH_TIMEOUT_SECONDS=2
REMOTE_PIPELINE_JOB_TIMEOUT_SECONDS=900
REMOTE_PIPELINE_POLL_SECONDS=1
REMOTE_PIPELINE_CIRCUIT_SECONDS=30
REMOTE_PIPELINE_ENRICH=true
REMOTE_PIPELINE_TTS=true
# Layered VPN TTS profile: zh/en -> (zh) mandarin/cantonese -> male/female.
# REMOTE_PIPELINE_TTS_VOICE is derived from these values for compatibility.
REMOTE_PIPELINE_TTS_LANGUAGE=zh
REMOTE_PIPELINE_TTS_DIALECT=mandarin
REMOTE_PIPELINE_TTS_GENDER=female
REMOTE_PIPELINE_TTS_VOICE=default
LOCAL_BROWSER_ENABLED=false

# Independent from RAGFLOW_UPLOAD_ENABLED. Enable only after
# tools/check_ragflow_llm_gate.py reports gate=ready.
RAGFLOW_LLM_ENABLED=false
RAGFLOW_LLM_MODEL_ID=
RAGFLOW_LLM_APP_ID=
RAGFLOW_LLM_TIMEOUT_SECONDS=45
RAGFLOW_LLM_MAX_RETRIES=1
RAGFLOW_LLM_MAX_INPUT_CHARS=20000
RAGFLOW_LLM_MAX_CONCURRENCY=2

# Financial intelligence and TradingAgents. All capabilities are opt-in.
# "开启模拟数据" in the admin UI maps only to TRADING_SIMULATION_ENABLED.
# Production fails closed unless every enabled financial Provider/RSS has a
# current profile and its provider/profile id is listed in the approvals value.
FINANCIAL_LICENSE_ENVIRONMENT=development
FINANCIAL_SOURCE_LICENSE_APPROVALS=
FINANCIAL_INTELLIGENCE_ENABLED=false
FINANCIAL_INFORMATION_NEEDS_ENABLED=true
FINANCIAL_INSTRUMENT_DISCOVERY_ENABLED=true
FINANCIAL_EXTERNAL_INSTRUMENT_DISCOVERY_ENABLED=true
# Optional only: search results propose candidate codes which must still pass
# exchange-directory and approved-provider verification before promotion.
FINANCIAL_INSTRUMENT_SEARCH_FALLBACK_ENABLED=true
FINANCIAL_INSTRUMENT_AUTO_PROMOTION_ENABLED=true
FINANCIAL_LATEST_NEWS_ENABLED=true
FINANCIAL_LATEST_BUNDLE_ENABLED=true
TRADING_AGENTS_ENABLED=false
FINANCIAL_AUTO_RESEARCH_ENABLED=false
TRADING_SIMULATION_ENABLED=false
# New installations start closed. Advance only one stage after its smoke and
# observation window pass: off -> rss -> snapshot_readonly -> dashboard ->
# ai_fact -> stock_research -> index_research -> history_review ->
# auto_research -> simulation_backtest.
FINANCIAL_ROLLOUT_STAGE=off
FINANCIAL_ROLLOUT_STAGE_CHANGED_AT=
FINANCIAL_ROLLOUT_OBSERVATION_SECONDS=3600
AKSHARE_CN_ENABLED=false
TUSHARE_CN_ENABLED=false
# Secret: obtain this from https://tushare.pro after registration. Leave empty
# unless the account and required endpoint permissions have been verified.
TUSHARE_TOKEN=
YAHOO_FINANCE_ENABLED=false
ALPHA_VANTAGE_ENABLED=false
# Free key: https://www.alphavantage.co/support/#api-key (currently 25 calls/day).
ALPHA_VANTAGE_API_KEY=
# Quote mode: none (free end-of-day), delayed, or realtime.
ALPHA_VANTAGE_QUOTE_ENTITLEMENT=none
# Set true only after purchasing and activating the selected delayed/realtime entitlement.
ALPHA_VANTAGE_REALTIME_ENTITLED=false
FRED_ENABLED=false
# Free registered key: https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=
POLYMARKET_ENABLED=false
EASYQUOTATION_ENABLED=false
OFFICIAL_FINANCIAL_EVIDENCE_ENABLED=false

# Provider request limits and daily budget.
FINANCIAL_PROVIDER_TIMEOUT_SECONDS=20
FINANCIAL_PROVIDER_MAX_RETRIES=2
FINANCIAL_PROVIDER_MAX_CONCURRENCY=4
FINANCIAL_PROVIDER_MAX_CONCURRENCY_PER_SOURCE=2
FINANCIAL_PROVIDER_ADMISSION_TIMEOUT_SECONDS=5
FINANCIAL_PROVIDER_DAILY_CALL_BUDGET=1000

# Bounded SQLite and report-file resource waits.
SQLITE_BUSY_TIMEOUT_MS=2000
FINANCIAL_ARTIFACT_MAX_BYTES=8388608
FINANCIAL_ARTIFACT_IO_MAX_CONCURRENCY=1
FINANCIAL_ARTIFACT_IO_TIMEOUT_SECONDS=5
FINANCIAL_INTERACTIVE_P95_BUDGET_MS=500
FINANCIAL_DASHBOARD_P95_BUDGET_MS=250
FINANCIAL_RSS_P95_BUDGET_MS=1000
FINANCIAL_HEALTH_PROVIDER_MAX_AGE_SECONDS=86400
FINANCIAL_HEALTH_SOURCE_MAX_AGE_SECONDS=86400
FINANCIAL_HEALTH_JOB_MAX_AGE_SECONDS=900
FINANCIAL_HEALTH_LLM_P95_MS=90000
FINANCIAL_HEALTH_REPORT_MAX_AGE_SECONDS=86400

# Freshness thresholds. Values are seconds and never imply exchange-grade SLA.
FINANCIAL_QUOTE_FRESHNESS_SECONDS=300
FINANCIAL_LATEST_QUOTE_TIMEOUT_SECONDS=6
FINANCIAL_LATEST_NEWS_TIMEOUT_SECONDS=40
FINANCIAL_LATEST_BUNDLE_TIMEOUT_SECONDS=45
FINANCIAL_MARKET_BREADTH_FRESHNESS_SECONDS=300
FINANCIAL_NEWS_FRESHNESS_SECONDS=3600
FINANCIAL_NEWS_LOOKBACK_DAYS=7
FINANCIAL_NEWS_LATEST_FALLBACK_SCAN_LIMIT=5000
FINANCIAL_NEWS_REFRESH_MAX_SOURCES=5
FINANCIAL_NEWS_REFRESH_ITEMS_PER_SOURCE=20
FINANCIAL_NEWS_REFRESH_TIMEOUT_SECONDS=10
FINANCIAL_NEWS_DISCOVERY_MAX_SOURCES=4
FINANCIAL_NEWS_DISCOVERY_MAX_CANDIDATES=12
FINANCIAL_FUNDAMENTAL_FRESHNESS_SECONDS=86400

# Per-research and automatic-research budgets.
FINANCIAL_RESEARCH_MAX_LLM_CALLS=30
FINANCIAL_RESEARCH_MAX_TOKENS=120000
FINANCIAL_RESEARCH_MAX_DEBATE_ROUNDS=2
FINANCIAL_RESEARCH_TIMEOUT_SECONDS=1800
FINANCIAL_RESEARCH_CACHE_SECONDS=3600
FINANCIAL_AUTO_RESEARCH_DAILY_BUDGET=6

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=
