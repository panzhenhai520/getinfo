# Generate a long random value before deployment. Requests other than /v1/health require it.
PIPELINE_API_TOKEN=replace-with-at-least-32-random-characters
PIPELINE_BIND_IP=10.88.0.1
PIPELINE_PORT=11236
PIPELINE_MAX_WORKERS=2
PIPELINE_DATA_DIR=/data
PIPELINE_JOB_TTL_DAYS=14

OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma431b-32k:latest
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_INPUT_CHARS=24000

TTS_BASE_URL=http://host.docker.internal:8005
TTS_MODEL=cosyvoice2
# Default TTS voice; per-job 'voice' from the client overrides this value.
TTS_VOICE=default
TTS_TIMEOUT_SECONDS=120

CRAWL_PAGE_TIMEOUT_MS=60000
CRAWL_MAX_ARTICLES=30
CRAWL_MAX_PAGES=3
CRAWL_DOMAIN_DELAY_SECONDS=1.0
ROBOTS_USER_AGENT=CollectInfoBot
ROBOTS_FAIL_CLOSED=true

