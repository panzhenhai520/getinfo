{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Market intelligence industry pack",
  "type": "object",
  "required": [
    "id",
    "name",
    "schema_version",
    "pack_version",
    "enabled",
    "default_market",
    "timezone",
    "core_keywords",
    "expanded_keywords",
    "trend_keywords",
    "event_keywords",
    "negative_keywords",
    "classification",
    "serpapi_queries",
    "default_sources",
    "fixed_topics"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 1},
    "schema_version": {"type": "integer", "enum": [1, 2, 3]},
    "pack_version": {"type": "string", "minLength": 1},
    "enabled": {"type": "boolean"},
    "default_market": {"type": "string"},
    "timezone": {"type": "string"},
    "core_keywords": {"type": "array", "items": {"type": "string"}},
    "expanded_keywords": {"type": "array", "items": {"type": "string"}},
    "trend_keywords": {"type": "array", "items": {"type": "string"}},
    "event_keywords": {"type": "array", "items": {"type": "string"}},
    "negative_keywords": {"type": "array", "items": {"type": "string"}},
    "classification": {
      "type": "object",
      "required": [
        "core_weight",
        "expanded_weight",
        "trend_weight",
        "event_weight",
        "negative_weight",
        "minimum_relevance_score",
        "llm_confidence_threshold",
        "tie_break_order"
      ],
      "properties": {
        "recent_today_window_days": {
          "type": "integer",
          "minimum": 1
        },
        "recent_trend_window_days": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "serpapi_queries": {"type": "array", "items": {"type": "string"}},
    "serpapi_query_gates": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "string", "minLength": 1}
      }
    },
    "default_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "url"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https?://"},
          "source_type": {"enum": ["website", "list_page", "rss"]},
          "source_role": {
            "enum": [
              "government_regulator",
              "official_investigation",
              "exchange_official",
              "academic_research",
              "independent_research",
              "industry_association",
              "issuer_official",
              "engineering_media",
              "professional_trade_media",
              "professional_advisor",
              "consumer_media",
              "unclassified"
            ]
          },
          "authority_level": {"type": "integer", "minimum": 1, "maximum": 5},
          "authority_scope": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "publisher_key": {"type": "string", "maxLength": 255},
          "polling_interval_minutes": {
            "type": "integer",
            "minimum": 5,
            "maximum": 10080
          },
          "is_enabled": {"type": "boolean"}
        },
        "additionalProperties": true
      }
    },
    "fixed_topics": {"type": "array", "items": {"type": "object"}},
    "pack_kind": {"type": "string", "enum": ["primary", "capability", "hybrid"]},
    "includes": {
      "type": "array",
      "items": {
        "oneOf": [
          {"type": "string", "pattern": "^[a-z0-9_]+$"},
          {
            "type": "object",
            "required": ["pack_id"],
            "properties": {
              "pack_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
              "required": {"type": "boolean"}
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "capabilities": {"$ref": "#/$defs/additiveCapabilities"},
    "dashboard_categories": {"$ref": "#/$defs/additiveCapabilities"},
    "dashboard_capabilities": {
      "type": "object",
      "required": [
        "show_financial_news",
        "show_market_index_cards",
        "show_watched_stock_cards",
        "show_spatiotemporal_map"
      ],
      "properties": {
        "show_financial_news": {"type": "boolean"},
        "show_market_index_cards": {"type": "boolean"},
        "show_watched_stock_cards": {"type": "boolean"},
        "show_spatiotemporal_map": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "ragflow_policy": {
      "type": "object",
      "required": ["upload_crawled_articles", "knowledge_base_key"],
      "properties": {
        "upload_crawled_articles": {"type": "boolean"},
        "knowledge_base_key": {"type": "string", "enum": ["news"]}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "additiveCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "name", "enabled"],
        "properties": {
          "key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "name": {"type": "string", "minLength": 1},
          "enabled": {"type": "boolean"},
          "activation_flag": {"type": "string"},
          "implementation_status": {"type": "string"}
        },
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}},
      "then": {
        "required": ["pack_kind", "includes", "capabilities", "dashboard_categories"]
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": 3}}},
      "then": {
        "required": [
          "pack_kind",
          "includes",
          "capabilities",
          "dashboard_categories",
          "dashboard_capabilities"
        ]
      }
    }
  ]
}
