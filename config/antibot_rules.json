{
  "schema_version": "antibot-rules-v1",
  "updated_at": "2026-10-07",
  "notes": [
    "自研反爬识别规则库：只做「识别是谁拦了我们 + 给出处置建议」，不做任何绕过。",
    "判据全部是公开事实（例如 Cloudflare 会下发 cf-ray 响应头、Akamai 会下发 _abck cookie），公开事实本身不受版权保护。",
    "规则分类 methods 与业界通行分类一致：cookie / header / url / content / dom / window / payload。",
    "weak=true 表示「CDN 存在性」信号：正常 200 响应也会出现（如 cf-ray），只在状态码属于 block_status 时才算拦截。",
    "confidence 为单条规则的置信度：>=0.6 视为可直接判定拦截；<0.6 只作辅助证据。",
    "kind: fingerprint=指纹型（TLS/HTTP 指纹过关即可）| js_sensor=JS 传感器型（必须真实浏览器执行 JS）| captcha=验证码型（需人工，机器无法通过）| waf=规则型 WAF。",
    "preferred_engine 表示下一步该试哪一级：curl_cffi / browser / manual。"
  ],
  "vendors": {
    "cloudflare": {
      "label": "Cloudflare",
      "kind": "fingerprint",
      "preferred_engine": "curl_cffi",
      "fallback_engine": "browser",
      "action": "retry_curl_cffi",
      "block_status": [403, 429, 503],
      "rules": [
        {"id": "cf-ray", "method": "header", "pattern": "(?i)^cf-ray:", "confidence": 0.35, "weak": true, "note": "Cloudflare 响应头，正常 200 也存在"},
        {"id": "cf-server", "method": "header", "pattern": "(?i)^server:\\s*cloudflare", "confidence": 0.3, "weak": true, "note": "Server: cloudflare"},
        {"id": "cf-mitigated", "method": "header", "pattern": "(?i)^cf-mitigated:\\s*(challenge|block)", "confidence": 0.95, "note": "Cloudflare 主动拦截标记"},
        {"id": "cf-bm-cookie", "method": "cookie", "pattern": "(?i)(^|[;\\s])__cf_bm=", "confidence": 0.45, "weak": true, "note": "Bot Management cookie 下发"},
        {"id": "cf-clearance", "method": "cookie", "pattern": "(?i)(^|[;\\s])cf_clearance=", "confidence": 0.5, "weak": true, "note": "已通过挑战后下发的通行 cookie"},
        {"id": "cf-chl-opt", "method": "window", "pattern": "(?i)_cf_chl_opt|__cfRLUnblockHandlers", "confidence": 0.85, "note": "挑战页注入的全局变量"},
        {"id": "cf-interstitial", "method": "content", "pattern": "(?i)just a moment\\.\\.\\.|checking your browser|enable javascript and cookies to continue", "confidence": 0.95, "note": "5 秒盾 / 浏览器检查页文案"},
        {"id": "cf-blocked", "method": "content", "pattern": "(?i)attention required!\\s*\\|\\s*cloudflare|you have been blocked", "confidence": 0.9, "note": "Cloudflare 拦截页标题"},
        {"id": "cf-challenge-platform", "method": "content", "pattern": "(?i)cdn-cgi/challenge-platform|/cdn-cgi/chl", "confidence": 0.9, "note": "挑战脚本路径"},
        {"id": "cf-chl-var", "method": "content", "pattern": "(?i)__cf_chl_|cf_chl_opt", "confidence": 0.9, "note": "挑战页内联变量"},
        {"id": "cf-url", "method": "url", "pattern": "(?i)/cdn-cgi/(challenge-platform|chl)", "confidence": 0.85, "note": "跳转到挑战 URL"}
      ]
    },
