[Unit]
Description=Info Aggregator Market Intelligence Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=timebot
Group=timebot
WorkingDirectory=/home/timebot/app
Environment=PYTHONUNBUFFERED=1
Environment=DATABASE_PATH=/home/timebot/app/data/crawler_articles.db
EnvironmentFile=-/home/timebot/app/.env
ExecStart=/usr/bin/python3 /home/timebot/app/intel_worker_supervisor.py
Restart=always
RestartSec=15
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
